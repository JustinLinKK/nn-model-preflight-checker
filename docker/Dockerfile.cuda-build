FROM nvidia/cuda:13.0.0-devel-ubuntu24.04

RUN apt-get update \
    && apt-get install -y --no-install-recommends python3 python3-pip build-essential \
    && rm -rf /var/lib/apt/lists/*

RUN groupadd --system preflight && useradd --system --gid preflight --create-home preflight
WORKDIR /opt/model-preflight
COPY pyproject.toml README.md LICENSE ./
COPY src ./src
RUN python3 -m pip install --break-system-packages .

USER preflight:preflight
ENTRYPOINT ["python3", "-m", "model_preflight.execution.worker_main"]
